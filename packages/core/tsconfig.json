{
  "extends": "@electron-theater/config/tsconfig.base.json",
  "compilerOptions": {
    // core runs in every client and in the backend, so it must not use browser or Node APIs: no "dom"
    // lib, and no automatic @types packages (some of the hoisted ones pull in the DOM types).
    "lib": ["esnext"],
    "types": [],
    "noEmit": true
  },
  "include": ["src"]
}
