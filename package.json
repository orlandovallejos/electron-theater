{
  "name": "electron-theater",
  "private": true,
  "description": "Swipe through movies and shows with a partner. When you both like the same title, it's a match.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm start -w @electron-theater/desktop",
    "build": "npm run build -w @electron-theater/desktop",
    "package": "npm run package -w @electron-theater/desktop",
    "rebuild": "npm run rebuild -w @electron-theater/desktop",
    "lint": "eslint --cache \"*.{js,mjs}\" && npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --cache"
    ],
    "*.json,.prettierrc": [
      "prettier --ignore-path .prettierignore --parser json --write"
    ],
    "*.{css,scss}": [
      "prettier --ignore-path .prettierignore --single-quote --write"
    ],
    "*.{html,md,yml}": [
      "prettier --ignore-path .prettierignore --single-quote --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orlandovallejos/electron-theater.git"
  },
  "author": {
    "name": "Orlando Vallejos",
    "email": "orlandovallejos@gmail.com",
    "url": "https://github.com/orlandovallejos"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/orlandovallejos/electron-theater/issues"
  },
  "keywords": [
    "electron",
    "react",
    "typescript",
    "movies",
    "tmdb"
  ],
  "homepage": "https://github.com/orlandovallejos/electron-theater#readme",
  "engines": {
    "node": ">=24"
  },
  "prettier": {
    "overrides": [
      {
        "files": [
          ".prettierrc"
        ],
        "options": {
          "parser": "json"
        }
      }
    ],
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "overrides": {
    "styled-components": "^5.3.3",
    "@types/react": "^18.3.31",
    "loader-utils": "^1.4.2",
    "minimist": "^1.2.8",
    "@babel/traverse": "^7.29.13"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "core-js": false,
    "core-js-pure": false,
    "electron-winstaller": false
  }
}
