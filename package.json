{
  "name": "movie-mates",
  "private": true,
  "description": "Swipe through movies and shows with a partner. When you both like the same title, it's a match.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm start -w @movie-mates/desktop",
    "build": "npm run build -w @movie-mates/desktop",
    "package": "npm run package -w @movie-mates/desktop",
    "rebuild": "npm run rebuild -w @movie-mates/desktop",
    "lint": "eslint --cache \"*.{js,mjs}\" && npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --cache"
    ],
    "*.json,.prettierrc": [
      "prettier --ignore-path .prettierignore --parser json --write"
    ],
    "*.{css,scss}": [
      "prettier --ignore-path .prettierignore --single-quote --write"
    ],
    "*.{html,md,yml}": [
      "prettier --ignore-path .prettierignore --single-quote --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@movie-mates/config": "*",
    "eslint": "^9",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3",
    "typescript": "~7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orlandovallejos/movie-mates.git"
  },
  "author": {
    "name": "Orlando Vallejos",
    "email": "orlandovallejos@gmail.com",
    "url": "https://github.com/orlandovallejos"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/orlandovallejos/movie-mates/issues"
  },
  "keywords": [
    "electron",
    "react",
    "typescript",
    "movies",
    "tmdb"
  ],
  "homepage": "https://github.com/orlandovallejos/movie-mates#readme",
  "engines": {
    "node": ">=24"
  },
  "prettier": "@movie-mates/config/prettier",
  "overrides": {
    "styled-components": "^5.3.3",
    "@types/react": "^18.3.31",
    "loader-utils": "^1.4.2",
    "minimist": "^1.2.8",
    "@babel/traverse": "^7.29.13"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "core-js": false,
    "core-js-pure": false,
    "electron-winstaller": false
  }
}
