{
  "name": "electron-theater",
  "productName": "Electron Theater",
  "description": "Swipe through movies and shows with a partner. When you both like the same title, it's a match.",
  "scripts": {
    "build": "concurrently \"npm run build:main\" \"npm run build:renderer\"",
    "build:main": "cross-env NODE_ENV=production TS_NODE_TRANSPILE_ONLY=true webpack --config ./.erb/configs/webpack.config.main.prod.ts",
    "build:renderer": "cross-env NODE_ENV=production TS_NODE_TRANSPILE_ONLY=true webpack --config ./.erb/configs/webpack.config.renderer.prod.ts",
    "rebuild": "electron-rebuild --parallel --types prod,dev,optional --module-dir src",
    "lint": "cross-env NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true eslint . --cache --ext .js,.jsx,.ts,.tsx",
    "package": "ts-node ./.erb/scripts/clean.js dist && npm run build && electron-builder build --publish never",
    "prepare": "husky",
    "postinstall": "ts-node .erb/scripts/check-native-dep.js && electron-builder install-app-deps && cross-env NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true webpack --config ./.erb/configs/webpack.config.renderer.dev.dll.ts && opencollective-postinstall",
    "start": "ts-node ./.erb/scripts/check-port-in-use.js && npm run start:renderer",
    "start:main": "cross-env NODE_ENV=development electron -r ts-node/register/transpile-only ./src/main/main.ts",
    "start:renderer": "cross-env NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true webpack serve --config ./.erb/configs/webpack.config.renderer.dev.ts",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "test": "jest --verbose=false --watchAll=false --coverage"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "cross-env NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true eslint --cache"
    ],
    "*.json,.{eslintrc,prettierrc}": [
      "prettier --ignore-path .eslintignore --parser json --write"
    ],
    "*.{css,scss}": [
      "prettier --ignore-path .eslintignore --single-quote --write"
    ],
    "*.{html,md,yml}": [
      "prettier --ignore-path .eslintignore --single-quote --write"
    ]
  },
  "build": {
    "productName": "Electron Theater",
    "appId": "com.orlandovallejos.electron-theater",
    "asar": true,
    "asarUnpack": "**\\*.{node,dll}",
    "files": [
      "dist",
      "node_modules",
      "package.json"
    ],
    "afterSign": ".erb/scripts/notarize.js",
    "mac": {
      "type": "distribution",
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "gatekeeperAssess": false
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo"
    },
    "directories": {
      "app": "release/app",
      "buildResources": "assets",
      "output": "release/build"
    },
    "extraResources": [
      "./assets/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "orlandovallejos",
      "repo": "electron-theater"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orlandovallejos/electron-theater.git"
  },
  "author": {
    "name": "Orlando Vallejos",
    "email": "orlandovallejos@gmail.com",
    "url": "https://github.com/orlandovallejos"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/orlandovallejos/electron-theater/issues"
  },
  "keywords": [
    "electron",
    "react",
    "typescript",
    "movies",
    "tmdb"
  ],
  "homepage": "https://github.com/orlandovallejos/electron-theater#readme",
  "jest": {
    "testEnvironment": "jsdom",
    "testEnvironmentOptions": {
      "url": "http://localhost/"
    },
    "transform": {
      "\\.(ts|tsx|js|jsx)$": "ts-jest"
    },
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/.erb/mocks/fileMock.js",
      "\\.(css|less|sass|scss)$": "identity-obj-proxy"
    },
    "moduleFileExtensions": [
      "js",
      "jsx",
      "ts",
      "tsx",
      "json"
    ],
    "moduleDirectories": [
      "node_modules",
      "release/app/node_modules"
    ],
    "testPathIgnorePatterns": [
      "release/app/dist"
    ],
    "setupFilesAfterEnv": [
      "./src/setupTests.ts"
    ],
    "fakeTimers": {
      "enableGlobally": true
    },
    "collectCoverage": true,
    "collectCoverageFrom": [
      "**/src/api/**/*.{ts,tsx}",
      "**/src/helpers/**/*.{ts,tsx}",
      "**/src/renderer/**/*.{ts,tsx}",
      "!**/src/renderer/**/*style.{ts,tsx}",
      "!**/node_modules/**",
      "!**/release/**"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 75,
        "branches": 70,
        "functions": 70,
        "lines": 75
      }
    },
    "coverageReporters": [
      "lcov",
      "text-summary"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.3",
    "@teamsupercell/typings-for-css-modules-loader": "^2.5.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.27",
    "@types/node": "16.18.126",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/styled-components": "^5",
    "@types/terser-webpack-plugin": "^5.0.4",
    "@types/webpack-env": "^1.16.2",
    "browserslist-config-erb": "^0.0.3",
    "chalk": "^4.1.2",
    "concurrently": "^10.0.6",
    "core-js": "^3.18.1",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.5",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "detect-port": "^2.1.0",
    "electron": "^15.1.0",
    "electron-builder": "^22.11.7",
    "electron-devtools-installer": "^3.2.0",
    "electron-notarize": "^1.1.1",
    "electron-rebuild": "^3.2.3",
    "eslint": "^7.32.0",
    "eslint-config-erb": "^4.0.3",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.6.8",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "lint-staged": "^17.6.0",
    "mini-css-extract-plugin": "^2.10.2",
    "opencollective-postinstall": "^2.0.3",
    "prettier": "^2.4.1",
    "react-refresh": "^0.19.0",
    "react-refresh-typescript": "^2.0.12",
    "rimraf": "^6.1.4",
    "sass": "^1.108.0",
    "sass-loader": "^17.1.0",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "url-loader": "^4.1.1",
    "webpack": "^5.112.2",
    "webpack-bundle-analyzer": "^5.4.2",
    "webpack-cli": "^7.3.1",
    "webpack-dev-server": "^6.1.0",
    "webpack-merge": "^6.0.1"
  },
  "dependencies": {
    "@emotion/react": "^11.10.8",
    "@emotion/styled": "^11.10.8",
    "@mui/joy": "^5.0.0-alpha.77",
    "axios": "^1.21.0",
    "dotenv": "^10.0.0",
    "electron-debug": "^3.2.0",
    "electron-log": "^4.4.1",
    "electron-store": "^8.0.1",
    "electron-updater": "^4.3.9",
    "lodash": "^4.17.21",
    "node-vibrant": "^3.1.6",
    "polished": "^4.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "regenerator-runtime": "^0.13.9",
    "styled-components": "^5.3.3"
  },
  "engines": {
    "node": ">=24"
  },
  "browserslist": [],
  "prettier": {
    "overrides": [
      {
        "files": [
          ".prettierrc",
          ".eslintrc"
        ],
        "options": {
          "parser": "json"
        }
      }
    ],
    "singleQuote": true
  },
  "resolutions": {
    "styled-components": "^5",
    "@types/react": "^18.3.31"
  }
}
