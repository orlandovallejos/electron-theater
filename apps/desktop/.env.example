# Copy this file to `.env` and fill in your values:
#
#   cp .env.example .env
#
# `.env` is git-ignored. Never commit real tokens.
# The main process loads it at startup (dotenv), so restart `npm start` after editing.

# API_URL (required)
# Base URL of The Movie Database (TMDB) API. Keep the trailing slash.
# Docs: https://developer.themoviedb.org/reference/intro/getting-started
API_URL=https://api.themoviedb.org/3/

# APP_TOKEN (required)
# Your TMDB "API Read Access Token" (a long JWT). It is sent as `Authorization: Bearer <token>`.
# Not the shorter "API Key". Create a free TMDB account, then copy the token from
# https://www.themoviedb.org/settings/api
APP_TOKEN=your-tmdb-read-access-token
